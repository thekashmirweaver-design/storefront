# Commerce provider: mock (default) | shopify
COMMERCE_PROVIDER=mock

# Public site URL (metadata, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://thekashmirweaver.com

# Required when COMMERCE_PROVIDER=shopify
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_token
# Storefront token needs unauthenticated_read_product_inventory for live quantity caps.
# After adding the scope, create a NEW Storefront access token and update SHOPIFY_STOREFRONT_ACCESS_TOKEN.
# SHOPIFY_STOREFRONT_API_VERSION=2025-01
# SHOPIFY_BLOG_HANDLE=news

# Required for newsletter + contact forms (Phase 5) when COMMERCE_PROVIDER=shopify
# Option A: direct Admin API token (production / CI)
# SHOPIFY_ADMIN_ACCESS_TOKEN=your_admin_api_token
# Option B: partner app CLI fallback (local dev — same as seed script)
# SHOPIFY_PARTNER_APP_DIR=/tmp/shopify-probe/kashmir-weaver-probe
# Needs read_customers + write_customers on the partner app (deploy + re-approve on store)
# SHOPIFY_ADMIN_API_VERSION=2025-07

# Phase 6 — Customer Account API (OAuth PKCE login, orders, wishlist sync)
# Option A — partner app: add [customer_authentication] to shopify.app.toml, deploy, use app Client ID
# Option B — Headless channel (Admin UI → Sales channels → Headless → Customer Account API):
#   - JavaScript origins: NEXT_PUBLIC_SITE_URL
#   - Redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/customer/callback
#   - Logout URI: {NEXT_PUBLIC_SITE_URL}/account
# SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your_customer_account_client_id
# Optional confidential client secret (server-side token exchange)
# SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=your_customer_account_client_secret
# SHOPIFY_CUSTOMER_ACCOUNT_API_VERSION=2025-04

# Phase 8 — Shopify webhooks for on-demand cache revalidation (catalog updates)
# Set to your Partner app API secret (Admin → Apps → kashmir-weaver-probe → API credentials)
# or the signing secret shown when creating a custom Admin webhook.
# SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret

# Phase 8 — Optional analytics (layout injects scripts when set)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_SHOPIFY_WEB_PIXEL_ID=your_custom_pixel_id

# Phase 8 — Shopify Markets / multi-currency (country picker + @inContext pricing)
# Cookie-driven when unset; env vars seed the default market for SSR/first visit.
# NEXT_PUBLIC_SHOPIFY_COUNTRY=US
# NEXT_PUBLIC_SHOPIFY_LANGUAGE=EN
